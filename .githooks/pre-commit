#!/bin/sh
# pre-commit hook — enforces that every commit includes a CHANGELOG.md update.
#
# Install once after cloning:
#   git config core.hooksPath .githooks

# Skip check on merge commits — no manual entry needed there.
if [ -f .git/MERGE_HEAD ]; then
    exit 0
fi

if ! git diff --cached --name-only | grep -q "^CHANGELOG\.md$"; then
    echo ""
    echo "  pre-commit: commit rejected — CHANGELOG.md is not staged."
    echo ""
    echo "  Add an entry describing your changes, then:"
    echo "    git add CHANGELOG.md"
    echo ""
    exit 1
fi

exit 0
