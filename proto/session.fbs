// proto/session.fbs — Connection handshake messages
// msg_type 0x01 HANDSHAKE (C→S)
// msg_type 0x02 HANDSHAKE_ACK (S→C)
//
// Compile with:
//   flatc --cpp --gen-object-api -o generated/ session.fbs

include "common.fbs";

namespace proto;

/// Scope of objects (switches, signals) that belong to one posterunek (sub-post).
table PosterunekInfo {
    posterunek_id: string (required);   // e.g. "GGO_nastawnia_A"
    station_sid:   string (required);   // e.g. "GGO"
    display_name:  string;
}

/// C → S  (msg_type 0x01)
table Handshake {
    /// Protocol version — must match server's supported version.
    proto_version:  uint32;

    /// Player identifier from the game-management system.
    player_id:      string (required);

    /// Bearer token issued by the auth service (HMAC-SHA256 signed JWT).
    auth_token:     string (required);

    /// Human-readable client version string for diagnostics.
    client_version: string;
}

/// S → C  (msg_type 0x02)
table HandshakeAck {
    /// Unique identifier for this simulation session.
    session_id:     string (required);

    /// Tick rate of the simulation engine in Hz (default: 20).
    server_tick_hz: uint32 = 20;

    /// List of posterunki this client is authorised to command.
    assigned_posterunki: [PosterunekInfo];

    /// Current wall-clock time at session start, microseconds since Unix epoch.
    server_time_us: uint64;
}

root_type HandshakeAck;
