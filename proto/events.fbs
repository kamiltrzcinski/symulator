// proto/events.fbs — Domain events (S → C broadcast, msg_type 0x20)
// The binary frame carries event_type (1 byte), event_id (4 bytes),
// timestamp_us (8 bytes) before this FlatBuffers payload.
//
// Compile with:
//   flatc --cpp --gen-object-api -o generated/ events.fbs

include "common.fbs";
include "commands.fbs";

namespace proto;

// ── event_type 0x01 ──────────────────────────────────────────────────────────
table SwitchPositionChanged {
    uid:          uint64;
    new_position: SwitchPosition;
    cause:        ChangeCause;
}

// ── event_type 0x02 ──────────────────────────────────────────────────────────
table SwitchOccupancyChanged {
    uid:        uint64;
    occupied:   bool;
    axle_count: int32;
    train_uid:  uint64;
}

// ── event_type 0x03 ──────────────────────────────────────────────────────────
table SignalAspectChanged {
    uid:        uint64;
    new_aspect: Aspect;
    cause:      ChangeCause;
}

// ── event_type 0x04 ──────────────────────────────────────────────────────────
table TrackSectionOccupancyChanged {
    uid:        uint64;
    occupied:   bool;
    axle_count: int32;
    train_uid:  uint64;
}

// ── event_type 0x05 ──────────────────────────────────────────────────────────
table DerailerPositionChanged {
    uid:          uint64;
    new_position: DerailerPosition;
    cause:        ChangeCause;
}

// ── event_type 0x06 ──────────────────────────────────────────────────────────
table BlockSectionStateChanged {
    uid:       uint64;
    new_state: BlockSectionState;
}

// ── event_type 0x07 ──────────────────────────────────────────────────────────
table RouteSet {
    uid:              uint64;
    from_signal_uid:  uint64;
    to_signal_uid:    uint64;
    section_uids:     [uint64];
}

// ── event_type 0x08 ──────────────────────────────────────────────────────────
enum RouteReleaseReason : byte {
    TRAIN_CLEARED   = 0,  // normal: train exited the route
    OPERATOR_CANCEL = 1,  // manual CancelRoute command
    TIMEOUT         = 2,  // no train entered within time limit
    CONFLICT        = 3,  // superseded by higher-priority route
}

table RouteReleased {
    route_uid: uint64;
    reason:    RouteReleaseReason;
}

// ── event_type 0x09 ──────────────────────────────────────────────────────────
enum Direction : byte {
    FORWARD  = 0,
    BACKWARD = 1,
}

table TrainMovement {
    train_uid:   uint64;
    section_uid: uint64;
    direction:   Direction;
    speed_kmh:   float;
}

// ── event_type 0x0A ──────────────────────────────────────────────────────────
enum AlarmType : byte {
    TRACK_OCCUPIED_UNEXPECTEDLY = 0,
    SWITCH_POSITION_MISMATCH    = 1,
    SIGNAL_OVERRUN              = 2,
    DERAILER_CONFLICT           = 3,
    COMMS_FAILURE               = 4,
    ENGINE_FAULT                = 5,
}

table AlarmRaised {
    alarm_uid:  uint64;
    alarm_type: AlarmType;
    object_uid: uint64;
    message:    string;
}

// ── event_type 0x0B ──────────────────────────────────────────────────────────
table AlarmCleared {
    alarm_uid: uint64;
}

// ── event_type 0x0C ──────────────────────────────────────────────────────────
table DispatchAreaOwnershipChanged {
    dispatch_area_uid:   uint64;
    station_uid:         uint64;
    new_owner_client_id: string;   // null = released (no owner)
}

// ── event_type 0x0D ──────────────────────────────────────────────────────────
table SessionStateChanged {
    new_state: SessionState;
}

// ── event_type 0x0E ──────────────────────────────────────────────────────────
table TrainComposed {
    train_uid:      uint64;
    vehicle_uids:   [uint64];
    total_length_m: float;
    total_axles:    int32;
}

// ── event_type 0x0F ──────────────────────────────────────────────────────────
enum TrainDecomposeReason : byte {
    UNCOUPLED      = 0,
    SCENARIO_RESET = 1,
    DERAILED       = 2,
}

table TrainDecomposed {
    train_uid: uint64;
    reason:    TrainDecomposeReason;
}

// ── event_type 0x10 ────────────────────────────────────────────────────────────
table BlockDirectionStateChanged {
    uid:           uint64;
    new_direction: BlockDirectionState;
    cause:         ChangeCause;
}

// ── event_type 0x11 ────────────────────────────────────────────────────────────
table OperatorCommandStateChanged {
    uid:          uint64;
    target_kind:  OperatorTargetKind;
    command_code: OperatorCommandCode;
    active:       bool;
}

// ── event_type 0x12 ────────────────────────────────────────────────────────────
table Ml8CommandStateChanged {
    uid:          uint64;
    target_kind:  OperatorTargetKind;
    command_code: Ml8CommandCode;
    active:       bool;
}

// ── event_type 0x13 ────────────────────────────────────────────────────────────
table DispatchTelegramStateChanged {
    exchange_uid:        uint64;
    src_area_uid:        uint64;
    dst_area_uid:        uint64;
    form_type:           DispatchFormType;
    direction:           TelegramDirection;
    train_number:        string;
    new_status:          ExchangeStatus;
    timestamp_us:        uint64 = 0;
}
