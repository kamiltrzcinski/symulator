// proto/dispatch_channel.fbs — Dispatch channel (msg_type 0x61 DISPATCH_CHANNEL_MESSAGE)
// Scoped to (src_area_uid, dst_area_uid) pair — neighbouring dispatch areas only.
//
// Compile with:
//   flatc --cpp --gen-object-api -o autogens/proto/ proto/dispatch_channel.fbs proto/common.fbs
//   (or via scripts/generate_compile_commands.py)

include "common.fbs";

namespace proto;

enum DispatchChannelMessageKind : byte {
    DISPATCH_FORM = 0,
    FREE_TEXT     = 1,
}

table DispatchFormPayload {
    form_type:    DispatchFormType;
    train_number: string (required);
    /// Kilometre markers of the protected section (e.g. ["102.4", "118.7"]).
    km_markers:   [string];
    /// Track number / line side (optional, e.g. "tor 1").
    track_number: string;
}

table FreeTextPayload {
    body: string (required);
}

union DispatchChannelMessageBody {
    DispatchFormPayload,
    FreeTextPayload,
}

table DispatchChannelMessage {
    /// Dispatch area UID of the initiating side (always filled by sender).
    src_area_uid:  uint64;
    /// Dispatch area UID of the receiving side (always filled by sender).
    dst_area_uid:  uint64;

    direction:     TelegramDirection;
    kind:          DispatchChannelMessageKind;
    body:          DispatchChannelMessageBody;

    // Fields below are filled by the server on outbound frames; clients send them empty:
    exchange_uid:  uint64;
    exchange_status: ExchangeStatus;
    timestamp_us:  uint64 = 0;   // microseconds since Unix epoch
    sender_id:     string;       // client_id of the sender
}

root_type DispatchChannelMessage;
