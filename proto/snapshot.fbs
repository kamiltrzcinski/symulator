// proto/snapshot.fbs — Full engine-state snapshot (S → C, msg_type 0x31)
// Snapshot is split into ≤64 kB chunks; IS_LAST_CHUNK flag in frame header
// signals the final chunk. seq_cursor is present only in the last chunk.
//
// Compile with:
//   flatc --cpp --gen-object-api -o generated/ snapshot.fbs

include "common.fbs";
include "commands.fbs";

namespace proto;

// ── Per-object state records ─────────────────────────────────────────────────

// Runtime operator-command flags for a single device.
// ml8_command_active + ml8_command_code together represent optional<Ml8CommandCode>:
// when ml8_command_active is false, ml8_command_code is undefined.
table OperatorCommandRuntimeState {
    stopped:                 bool;
    substitute_initialized:  bool;
    substitute_active:       bool;
    automatic_route_enabled: bool;
    clamped:                 bool;
    traffic_closed:          bool;
    detection_bypassed:      bool;
    special_initialized:     bool;
    special_active:          bool;
    axle_reset_initialized:  bool;
    ml8_command_active:      bool;
    ml8_command_code:        Ml8CommandCode;
}

table SwitchState {
    uid:       uint64;
    position:  SwitchPosition;
    occupied:  bool;
    axle_count: int32;
    train_uid:  uint64;
    locked_by_route: bool;
    operator_state: OperatorCommandRuntimeState;
}

table TrackSectionState {
    uid:       uint64;
    occupied:  bool;
    axle_count: int32;
    train_uid:  uint64;
    operator_state: OperatorCommandRuntimeState;
}

table SignalState {
    uid:    uint64;
    aspect: Aspect;
    operator_state: OperatorCommandRuntimeState;
}

table DerailerState {
    uid:      uint64;
    position: DerailerPosition;
    operator_state: OperatorCommandRuntimeState;
}

table BlockSectionSnapshotState {
    uid:             uint64;
    state:           BlockSectionState;
    block_direction: BlockDirectionState;
    operator_state:  OperatorCommandRuntimeState;
}

table RouteState {
    uid:              uint64;
    from_signal_uid:  uint64;
    to_signal_uid:    uint64;
    section_uids:     [uint64];
}

table AlarmState {
    uid:        uint64;
    alarm_type: int8;   // AlarmType byte value — cross-file enum reference
    object_uid: uint64;
    message:    string;
}

table DispatchAreaOwnership {
    dispatch_area_uid: uint64;
    station_uid:       uint64;
    owner_client_id:   string;   // null = unassigned
}

table TrainState {
    uid:            uint64;
    vehicle_uids:   [uint64];
    section_uid:    uint64;    // current section
    direction:      int8;      // Direction byte value
    speed_kmh:      float;
    total_length_m: float;
    total_axles:    int32;
}

// ── Root snapshot table ──────────────────────────────────────────────────────

table Snapshot {
    /// Must match the server's current schema_version to be parseable.
    schema_version:         uint32;

    session_id:             string (required);

    /// seq_id of the last DOMAIN_EVENT included in this snapshot.
    /// Events with seq_id > seq_cursor are guaranteed to be newer.
    seq_cursor:             uint32;

    /// Server wall-clock time when snapshot was captured, µs since Unix epoch.
    timestamp_us:           uint64;

    switches:               [SwitchState];
    track_sections:         [TrackSectionState];
    signals:                [SignalState];
    derailers:              [DerailerState];
    block_sections:         [BlockSectionSnapshotState];
    active_routes:          [RouteState];
    active_alarms:          [AlarmState];
    dispatch_area_assignments: [DispatchAreaOwnership];
    trains:                 [TrainState];
}

root_type Snapshot;
