    SIGNAL              = 0,
    SWITCH              = 1,
    DERAILER            = 2,
    TRACK_SECTION       = 3,
    BLOCK_SECTION       = 4,
    AXLE_COUNTER_SYSTEM = 5,
    STATION             = 6,
    ROUTE               = 7,
    LEVEL_CROSSING      = 8,
    INTERLOCKING_COMPUTER = 9,
    POWER_SUPPLY        = 10,
}

