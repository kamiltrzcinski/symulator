// proto/commands.fbs — Operator commands (C → S, msg_type 0x10)
// The binary frame carries cmd_type (1 byte) before this FlatBuffers payload.
//
// Compile with:
//   flatc --cpp --gen-object-api -o generated/ commands.fbs

include "common.fbs";

namespace proto;

// ── cmd_type 0x01 ────────────────────────────────────────────────────────────
/// Move a switch (zwrotnica) to the requested position.
table SetSwitchPosition {
    uid:      uint64;           // object UID
    position: SwitchPosition;
}

// ── cmd_type 0x02 ────────────────────────────────────────────────────────────
/// Override the aspect displayed on a signal (semafor).
/// Prefer RequestRoute for normal operation; use this only for manual override.
table SetSignalAspect {
    uid:    uint64;
    aspect: Aspect;
}

// ── cmd_type 0x03 ────────────────────────────────────────────────────────────
/// Toggle a derailer (wykolejnica).
table SetDerailerPosition {
    uid:      uint64;
    position: DerailerPosition;
}

// ── cmd_type 0x04 ────────────────────────────────────────────────────────────
/// Open or close a block section (blok liniowy).
table SetBlockSection {
    uid:   uint64;
    state: BlockSectionState;
}

// ── cmd_type 0x05 ────────────────────────────────────────────────────────────
/// High-level route request.
/// The engine resolves required switch positions and signal aspects internally.
table RequestRoute {
    from_signal_uid: uint64;  // entry signal UID
    to_signal_uid:   uint64;  // exit signal UID
}

// ── cmd_type 0x06 ────────────────────────────────────────────────────────────
/// Cancel a previously set route.
table CancelRoute {
    route_uid: uint64;
}

// ── cmd_type 0x07 ────────────────────────────────────────────────────────────
/// Acknowledge an alarm displayed on the dispatcher's panel.
table AcknowledgeAlarm {
    alarm_uid: uint64;
}

// ── cmd_type 0x08 ────────────────────────────────────────────────────────────
/// SHL-12 block-section direction control (ESTW ML8 only).
/// Values must match engine::core::Shl12Op (engine/include/engine/core/command.hpp).
enum Shl12Op : byte {
    BLW  = 0,  // żądaj kierunku wyjazdowego (NEUTRAL → OUTBOUND_PENDING)
    BLP  = 1,  // Potwierdź kierunek (OUTBOUND_PENDING → OUTBOUND / INBOUND_PENDING → INBOUND)
    BLO  = 2,  // Cofnij żądanie (OUTBOUND_PENDING → NEUTRAL)
    BLZ  = 3,  // Zwolnij kierunek (OUTBOUND/INBOUND → NEUTRAL)
    BLAI = 4,  // Inicjuj awaryjną zmianę kierunku
    BLA  = 5,  // Wykonaj awaryjną zmianę kierunku
    OPS  = 6,  // Anuluj procedurę specjalną
}

table SetBlockDirection {
    block_section_uid: uint64;
    operation:         Shl12Op;
}

// ── cmd_type 0x09 ────────────────────────────────────────────────────────────
/// Initiate axle-counter reset sequence (SLI — ESTW ML8 only).
table InitAxleCounterReset {
    block_section_uid: uint64;
}

// ── cmd_type 0x0A ────────────────────────────────────────────────────────────
/// Execute axle-counter reset (SLK — ESTW ML8 only).
table ResetAxleCounter {
    block_section_uid: uint64;
}

// cmd_type 0x20
