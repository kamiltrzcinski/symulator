/* thales.qss */
/* 
 * Plik stylów CSS/QSS dla klienta Thales ML8. 
 * Pozwala na separację logiki wizualnej od kodu w C++.
 */

QMainWindow {
    background-color: #2c3e50;
}

#displayArea {
    background-color: #34495e;
    color: #ecf0f1;
    font-family: monospace;
    font-size: 14pt;
    border: 1px solid #7f8c8d;
    border-radius: 4px;
    padding: 5px;
}

#inputField {
    background-color: #ecf0f1;
    color: #2c3e50;
    font-size: 14pt;
    font-weight: bold;
    padding: 5px;
    border: 2px solid #3498db;
    border-radius: 4px;
}

#inputField:focus {
    border-color: #e74c3c;
}

#specButton {
    background-color: #e74c3c;
    color: white;
    font-size: 14pt;
    font-weight: bold;
    padding: 10px;
    border-radius: 4px;
    border: none;
}

#specButton:disabled {
    background-color: #95a5a6;
    color: #7f8c8d;
}

#specButton:hover:!disabled {
    background-color: #c0392b;
}

#specButton:pressed:!disabled {
    background-color: #a93226;
}
