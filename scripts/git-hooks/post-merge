#!/usr/bin/env python3
# scripts/git-hooks/post-merge
#
# Runs automatically after every successful `git pull` / `git merge`.
# Cross-platform (Linux, macOS, Windows with Git for Windows).

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(
    subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
)
FETCH_SCRIPT = REPO_ROOT / "scripts" / "fetch_packages.py"

if not FETCH_SCRIPT.exists():
    print(f"[post-merge] WARNING: {FETCH_SCRIPT} not found — skipping.", file=sys.stderr)
    sys.exit(0)

subprocess.run([sys.executable, str(FETCH_SCRIPT)], check=False)
