{
  "$comment": "Command type catalog (JSON prototype). Runtime execution on engine bus remains binary.",
  "schema_version": 1,
  "catalog_kind": "command_types",
  "source": "proto/commands.fbs",
  "payload_schema_format": "json-schema-subset-v1",
  "command_types": [
    {
      "cmd_type": "SetSwitchPosition",
      "cmd_code": "0x01",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "g_id",
          "position"
        ],
        "properties": {
          "g_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 3,
            "maxLength": 128
          },
          "position": {
            "type": "string",
            "enum": [
              "NORMAL",
              "REVERSE"
            ]
          }
        }
      }
    },
    {
      "cmd_type": "SetSignalAspect",
      "cmd_code": "0x02",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "g_id",
          "aspect"
        ],
        "properties": {
          "g_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 3,
            "maxLength": 128
          },
          "aspect": {
            "type": "string",
            "enum": [
              "STOP",
              "S1",
              "S2",
              "SH1",
              "OFF",
              "S3",
              "MS1",
              "MS2"
            ]
          }
        }
      }
    },
    {
      "cmd_type": "SetDerailerPosition",
      "cmd_code": "0x03",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
