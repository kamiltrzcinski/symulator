        "properties": {
          "from_signal_g_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 3,
            "maxLength": 128
          },
          "to_signal_g_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 3,
            "maxLength": 128
          }
        }
      }
    },
    {
      "cmd_type": "CancelRoute",
