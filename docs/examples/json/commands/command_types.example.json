            "maxLength": 128
          },
          "position": {
            "type": "string",
            "enum": [
              "LOCKED",
              "UNLOCKED"
            ]
          }
        }
      }
    },
    {
      "cmd_type": "SetBlockSection",
      "cmd_code": "0x04",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "g_id",
          "state"
        ],
        "properties": {
          "g_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 3,
            "maxLength": 128
          },
          "state": {
            "type": "string",
            "enum": [
              "OPEN",
              "CLOSED"
            ]
          }
